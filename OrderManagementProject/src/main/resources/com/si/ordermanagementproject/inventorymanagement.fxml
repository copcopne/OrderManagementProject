<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.si.ordermanagementproject.InventoryManagementController">
   <children>
      <HBox alignment="TOP_CENTER" prefHeight="34.0" prefWidth="645.0">
         <children>
            <TextField fx:id="txtSearch" prefHeight="34.0" prefWidth="278.0" promptText="Tìm kiếm sản phẩm..." HBox.hgrow="ALWAYS">
               <HBox.margin>
                  <Insets left="5.0" />
               </HBox.margin>
            </TextField>
            <Button fx:id="importBtn" mnemonicParsing="false" prefHeight="34.0" prefWidth="109.0" text="Nhập hàng">
               <HBox.margin>
                  <Insets left="10.0" right="10.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="deductBtn" mnemonicParsing="false" prefHeight="34.0" prefWidth="113.0" text="Xuất hàng">
               <HBox.margin>
                  <Insets right="5.0" />
               </HBox.margin>
            </Button>
         </children>
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin>
      </HBox>
      <TableView fx:id="tbProducts" prefHeight="514.0" prefWidth="645.0">
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin></TableView>
   </children>
   <padding>
      <Insets top="10.0" />
   </padding>
</VBox>
